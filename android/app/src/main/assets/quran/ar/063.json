[{"j":28,"p":554,"r":221,"u":["إِذَا","ج{madda_obligatory_mottasel|َا}ٓءَكَ","{ham_wasl|ٱ}لۡمُنَ{madda_normal|ـٰ}فِقُونَ","قَالُو{slnt|اۡ}","نَشۡهَدُ","إِ{ghunnah|نّ}َكَ","لَرَسُولُ","{ham_wasl|ٱ}للَّهِ‌ۗ","وَ{ham_wasl|ٱ}للَّهُ","يَعۡلَمُ","إِ{ghunnah|نّ}َكَ","لَرَسُولُهُ{madda_normal|ۥ}","وَ{ham_wasl|ٱ}للَّهُ","يَشۡهَدُ","إِ{ghunnah|نّ}َ","{ham_wasl|ٱ}لۡمُنَ{madda_normal|ـٰ}فِقِينَ","لَكَ{madda_normal|ـٰ}ذِب{madda_permissible|ُو}نَ"],"i":["اِذَا","جَآءَكَ","الۡمُنٰفِقُوۡنَ","قَالُوۡا","نَشۡهَدُ","اِنَّكَ","لَرَسُوۡلُ","اللّٰهِ ​ۘ","وَاللّٰهُ","يَعۡلَمُ","اِنَّكَ","لَرَسُوۡلُهٗ ؕ","وَاللّٰهُ","يَشۡهَدُ","اِنَّ","الۡمُنٰفِقِيۡنَ","لَـكٰذِبُوۡنَ​ ۚ‏"]},{"j":28,"p":554,"r":221,"u":["ٱتَّخَذ{madda_obligatory_mottasel|ُوٓ}{slnt|اۡ}","أَيۡمَ{madda_normal|ـٰ}نَهُمۡ","جُ{ghunnah|نّ}َ{ikhafa|ةً}","{ikhafa|ف}َصَدُّو{slnt|اۡ}","عَ{ikhafa|ن}","{ikhafa|س}َبِيلِ","{ham_wasl|ٱ}للَّهِ‌ۚ","إِ{ghunnah|نّ}َهُمۡ","س{madda_obligatory_mottasel|َا}ٓءَ","مَا","كَانُو{slnt|اۡ}","يَعۡمَل{madda_permissible|ُو}نَ"],"i":["اِتَّخَذُوۡۤا","اَيۡمَانَهُمۡ","جُنَّةً","فَصَدُّوۡا","عَنۡ","سَبِيۡلِ","اللّٰهِ​ؕ","اِنَّهُمۡ","سَآءَ","مَا","كَانُوۡا","يَعۡمَلُوۡنَ‏"]},{"j":28,"p":554,"r":221,"u":["ذ{madda_normal|ٰ}لِكَ","بِأَ{ghunnah|نّ}َهُمۡ","ءَامَنُو{slnt|اۡ}","ثُ{ghunnah|مّ}َ","كَفَرُو{slnt|اۡ}","فَطُبِعَ","عَلَىٰ","قُلُوبِهِمۡ","فَهُمۡ","لَا","يَفۡقَه{madda_permissible|ُو}نَ"],"i":["ذٰلِكَ","بِاَنَّهُمۡ","اٰمَنُوۡا","ثُمَّ","كَفَرُوۡا","فَطُبِعَ","عَلٰى","قُلُوۡبِهِمۡ","فَهُمۡ","لَا","يَفۡقَهُوۡنَ‏"]},{"j":28,"p":554,"r":222,"u":["۞وَإِذَا","رَأَيۡتَهُمۡ","تُعۡجِبُكَ","أَ{qalaqah|جۡ}سَامُهُمۡ‌ۖ","وَإ{idgham_ghunnah|ِن}","{idgham_ghunnah|ي}َقُولُو{slnt|اۡ}","تَسۡمَعۡ","لِقَوۡلِهِمۡ‌ۖ","كَأَ{ghunnah|نّ}َهُمۡ","خُشُ{idgham_ghunnah|بٌ}","{idgham_ghunnah|م}ُّسَ{ghunnah|نّ}َدَ{idgham_ghunnah|ةٌ‌ۖ}","{idgham_ghunnah|ي}َحۡسَبُونَ","كُلَّ","صَيۡحَةٍ","عَلَيۡهِمۡ‌ۚ","هُمُ","{ham_wasl|ٱ}لۡعَدُوُّ","فَ{ham_wasl|ٱ}حۡذَرۡهُمۡ‌ۚ","قَ{madda_normal|ـٰ}تَلَهُمُ","{ham_wasl|ٱ}للَّهُ‌ۖ","أَ{ghunnah|نّ}َىٰ","يُؤۡفَك{m