[{"j":28,"p":558,"r":223,"u":["يَ{madda_obligatory_mottasel|ـٰٓ}أَيُّهَا","{ham_wasl|ٱ}{laam_shamsiyah|ل}{ghunnah|نّ}َبِىُّ","إِذَا","طَلَّ{qalaqah|قۡ}تُمُ","{ham_wasl|ٱ}{laam_shamsiyah|ل}{ghunnah|نّ}ِس{madda_obligatory_mottasel|َا}ٓءَ","فَطَلِّقُوهُ{ghunnah|نّ}َ","لِعِدَّتِهِ{ghunnah|نّ}َ","وَأَحۡصُو{slnt|اۡ}","{ham_wasl|ٱ}لۡعِدَّةَ‌ۖ","وَ{ham_wasl|ٱ}تَّقُو{slnt|اۡ}","{ham_wasl|ٱ}للَّهَ","رَبَّكُمۡ‌ۖ","لَا","تُخۡرِجُوهُ{ghunnah|نّ}َ","م{iqlab|ِنۢ}","{iqlab|ب}ُيُوتِهِ{ghunnah|نّ}َ","وَلَا","يَخۡرُ{qalaqah|جۡ}نَ","إِلّ{madda_obligatory_monfasel|َآ}","أ{idgham_ghunnah|َن}","{idgham_ghunnah|ي}َأۡتِينَ","بِفَ{madda_normal|ـٰ}حِشَ{idgham_ghunnah|ةٍ}","{idgham_ghunnah|م}ُّبَيِّنَ{idgham_ghunnah|ةٍ‌ۚ}","{idgham_ghunnah|و}َتِلۡكَ","حُدُودُ","{ham_wasl|ٱ}للَّهِ‌ۚ","وَم{idgham_ghunnah|َن}","{idgham_ghunnah|ي}َتَعَدَّ","حُدُودَ","{ham_wasl|ٱ}للَّهِ","فَقَ{qalaqah|دۡ}","ظَلَمَ","نَفۡسَهُ{madda_normal|ۥ}‌ۚ","لَا","تَ{qalaqah|دۡ}رِى","لَعَلَّ","{ham_wasl|ٱ}للَّهَ","يُحۡدِثُ","بَعۡدَ","ذ{madda_normal|ٰ}لِكَ","أَمۡرًا"],"i":["يٰۤاَيُّهَا","النَّبِىُّ","اِذَا","طَلَّقۡتُمُ","النِّسَآءَ","فَطَلِّقُوۡهُنَّ","لِعِدَّتِهِنَّ","وَاَحۡصُوا","الۡعِدَّةَ ​ ۚ","وَاتَّقُوا","اللّٰهَ","رَبَّكُمۡ​ ۚ","لَا","تُخۡرِجُوۡهُنَّ","مِنۡۢ","بُيُوۡتِهِنَّ","وَلَا","يَخۡرُجۡنَ","اِلَّاۤ","اَنۡ","يَّاۡتِيۡنَ","بِفَاحِشَةٍ","مُّبَيِّنَةٍ​ ؕ","وَتِلۡكَ","حُدُوۡدُ","اللّٰهِ​ ؕ","وَمَنۡ","يَّتَعَدَّ","حُدُوۡدَ","اللّٰهِ","فَقَدۡ","ظَلَمَ","نَفۡسَهٗ​ ؕ","لَا","تَدۡرِىۡ","لَعَلَّ","اللّٰهَ","يُحۡدِثُ","بَعۡدَ","ذٰ لِكَ","اَمۡرًا‏"]},{"j":28,"p":558,"r":223,"u":["فَإِذَا","بَلَغۡنَ","أَجَلَهُ{ghunnah|نّ}َ","فَأَمۡسِكُوهُ{ghunnah|نّ}َ","بِمَعۡرُوفٍ","أَوۡ","فَارِقُوهُ{ghunnah|نّ}َ","بِمَعۡرُو{idgham_ghunnah|فٍ}","{idgham_ghunnah|و}َأَشۡهِدُو{slnt|اۡ}","ذَوَىۡ","عَ{qalaqah|دۡ}{idgham_ghunnah|لٍ}","{idgham_ghunnah|م}ِّ{ikhafa|نك}ُمۡ","وَأَقِيمُو{slnt|اۡ}","{ham_wasl|ٱ}{laam_shamsiyah|ل}شَّهَ{madda_normal|ـٰ}دَةَ","لِلَّهِ‌ۚ","ذ{madda_normal|ٰ}لِكُمۡ","يُوعَظُ","بِه{madda_normal|ِۦ}","مَ{ikhafa|ن}","{ikhafa|ك}َانَ