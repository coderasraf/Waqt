[{"j":26,"p":515,"r":206,"u":["يَ{madda_obligatory_mottasel|ـٰٓ}أَيُّهَا","{ham_wasl|ٱ}لَّذِينَ","ءَامَنُو{slnt|اۡ}","لَا","تُقَدِّمُو{slnt|اۡ}","بَيۡنَ","يَدَىِ","{ham_wasl|ٱ}للَّهِ","وَرَسُولِه{madda_normal|ِۦ}‌ۖ","وَ{ham_wasl|ٱ}تَّقُو{slnt|اۡ}","{ham_wasl|ٱ}للَّهَ‌ۚ","إِ{ghunnah|نّ}َ","{ham_wasl|ٱ}للَّهَ","سَمِيعٌ","عَل{madda_permissible|ِي}مٌ"],"i":["يٰۤاَيُّهَا","الَّذِيۡنَ","اٰمَنُوۡا","لَا","تُقَدِّمُوۡا","بَيۡنَ","يَدَىِ","اللّٰهِ","وَرَسُوۡلِهٖ​","وَ اتَّقُوا","اللّٰهَ​ؕ","اِنَّ","اللّٰهَ","سَمِيۡعٌ","عَلِيۡمٌ‏"]},{"j":26,"p":515,"r":206,"u":["يَ{madda_obligatory_mottasel|ـٰٓ}أَيُّهَا","{ham_wasl|ٱ}لَّذِينَ","ءَامَنُو{slnt|اۡ}","لَا","تَرۡفَع{madda_obligatory_mottasel|ُوٓ}{slnt|اۡ}","أَصۡو{madda_normal|ٰ}تَكُمۡ","فَوۡقَ","صَوۡتِ","{ham_wasl|ٱ}{laam_shamsiyah|ل}{ghunnah|نّ}َبِىِّ","وَلَا","تَ{qalaqah|جۡ}هَرُو{slnt|اۡ}","لَهُ{madda_normal|ۥ}","بِ{ham_wasl|ٱ}لۡقَوۡلِ","كَجَهۡرِ","بَعۡضِكُمۡ","لِبَعۡضٍ","أَ{ikhafa|ن}","{ikhafa|ت}َحۡبَطَ","أَعۡمَ{madda_normal|ـٰ}لُكُمۡ","وَأَ{ikhafa|نت}ُمۡ","لَا","تَشۡعُر{madda_permissible|ُو}نَ"],"i":["يٰۤاَيُّهَا","الَّذِيۡنَ","اٰمَنُوۡا","لَا","تَرۡفَعُوۡۤا","اَصۡوَاتَكُمۡ","فَوۡقَ","صَوۡتِ","النَّبِىِّ","وَلَا","تَجۡهَرُوۡا","لَهٗ","بِالۡقَوۡلِ","كَجَهۡرِ","بَعۡضِكُمۡ","لِبَعۡضٍ","اَنۡ","تَحۡبَطَ","اَعۡمَالُكُمۡ","وَاَنۡـتُمۡ","لَا","تَشۡعُرُوۡنَ‏"]},{"j":26,"p":515,"r":206,"u":["إِ{ghunnah|نّ}َ","{ham_wasl|ٱ}لَّذِينَ","يَغُضُّونَ","أَصۡو{madda_normal|ٰ}تَهُمۡ","عِ{ikhafa|ند}َ","رَسُولِ","{ham_wasl|ٱ}للَّهِ","أُ{slnt|وۡ}لَ{madda_obligatory_mottasel|ـٰٓ}ئِكَ","{ham_wasl|ٱ}لَّذِينَ","{ham_wasl|ٱ}مۡتَحَنَ","{ham_wasl|ٱ}للَّهُ","قُلُوبَهُمۡ","لِلتَّ{qalaqah|قۡ}وَىٰ‌ۚ","لَه{idgham_shafawi|ُم}","{idgham_shafawi|م}َّغۡفِرَ{idgham_ghunnah|ةٌ}","{idgham_ghunnah|و}َأَ{qalaqah|جۡ}رٌ","عَظ{madda_permissible|ِي}مٌ"],"i":["اِنَّ","الَّذِيۡنَ","يَغُضُّوۡنَ","اَصۡوَاتَهُمۡ","عِنۡدَ","رَسُوۡلِ","اللّٰهِ","اُولٰٓٮِٕكَ","الَّذِيۡنَ","امۡتَحَنَ","اللّٰهُ","قُلُوۡبَهُمۡ","لِلتَّقۡوٰى​ؕ","لَهُمۡ","مَّغۡفِرَةٌ","وَّاَجۡرٌ","عَظِيۡمٌ‏"]},{"j":26,"p":515,"r":206,"u":["إِ{ghunnah|نّ}َ","{ham_wasl|ٱ}لَّذِينَ","يُنَادُونَكَ","م{idgham_ghunnah|ِن}","{idgham_ghunnah|و}َر{madda_obligatory_mottasel|َا}ٓءِ","{ham_wasl|ٱ}لۡحُجُر{madda_normal|ٰ}تِ","أَكۡثَرُهُمۡ","لَا","يَعۡقِل{madda_permissible|ُو}نَ"],"i":["اِنَّ","الَّذِيۡنَ","يُنَادُوۡنَكَ","مِنۡ","وَّرَآءِ","الۡحُجُرٰتِ","اَكۡثَرُهُمۡ","لَا","يَعۡقِلُوۡنَ‏"]},{"j":26,"p":516,"r":206,"u":["وَلَوۡ","أَ{ghunnah|نّ}َهُمۡ","صَبَرُو{slnt|اۡ}","حَتَّىٰ","تَخۡرُجَ","إِلَيۡهِمۡ","لَكَانَ","خَيۡ{idgham_wo_ghunnah|رًا}","{idgham_wo_ghunnah|ل}َّهُمۡ‌ۚ","وَ{ham_wasl|ٱ}للَّهُ","غَفُو{idgham_wo_ghunnah|رٌ}","{idgham_wo_ghunnah|ر}َّح{madda_permissible|ِي}مٌ"],"i":["وَلَوۡ","اَنَّهُمۡ","صَبَرُوۡا","حَتّٰى","تَخۡرُجَ","اِلَيۡهِمۡ","لَـكَانَ","خَيۡرًا","لَّهُمۡ​ؕ","وَاللّٰهُ","غَفُوۡرٌ","رَّحِيۡمٌ‏"]},{"j":26,"p":516,"r":206,"u":["يَ{madda_obligatory_mottasel|ـٰٓ}أَيُّهَا","{ham_wasl|ٱ}لَّذِينَ","ءَامَن{madda_obligatory_mottasel|ُوٓ}{slnt|اۡ}","إِ{ikhafa|ن}","{ikhafa|ج}{madda_obligatory_mottasel|َا}ٓءَكُمۡ","فَاسِ{iqlab|قُۢ}","{iqlab|ب}ِنَبَ{ikhafa|إٍ}","{ikhafa|ف}َتَبَيَّن{madda_obligatory_mottasel|ُوٓ}{slnt|اۡ}","أَ{ikhafa|ن}","{ikhafa|ت}ُصِيبُو{slnt|اۡ}","قَوۡم{iqlab|َۢا}","{iqlab|ب}ِجَهَ{madda_normal|ـٰ}لَ{ikhafa|ةٍ}","{ikhafa|ف}َتُصۡبِحُو{slnt|اۡ}","عَلَىٰ","مَا","فَعَلۡتُمۡ","نَ{madda_normal|ـٰ}دِم{madda_permissible|ِي}نَ"],"i":["يٰۤاَيُّهَا","الَّذِيۡنَ","اٰمَنُوۡۤا","اِنۡ","جَآءَكُمۡ","فَاسِقٌ ۢ","بِنَبَاٍ","فَتَبَيَّنُوۡۤا","اَنۡ","تُصِيۡبُوۡا","قَوۡمًا ۢ","بِجَهَالَةٍ","فَتُصۡبِحُوۡا","عَلٰى","مَا","فَعَلۡتُمۡ","نٰدِمِيۡنَ‏ ﻿﻿"]},{"j":26,"p":516,"r":206,"u":["وَ{ham_wasl|ٱ}عۡلَم{madda_obligatory_mottasel|ُوٓ}{slnt|اۡ}","أَ{ghunnah|نّ}َ","فِيكُمۡ","رَسُولَ","{ham_wasl|ٱ}للَّهِ‌ۚ","لَوۡ","يُطِيعُكُمۡ","فِى","كَثِي{idgham_ghunnah|رٍ}","{idgham_ghunnah|م}ِّنَ","{ham_wasl|ٱ}لۡأَمۡرِ","لَعَنِتُّمۡ","وَلَ{madda_normal|ـٰ}كِ{ghunnah|نّ}َ","{ham_wasl|ٱ}للَّهَ","حَبَّبَ","إِلَيۡكُمُ","{ham_wasl|ٱ}لۡإِيمَ{madda_normal|ـٰ}نَ","وَزَيَّنَهُ{madda_normal|ۥ}","فِى","قُلُوبِكُمۡ","وَكَرَّ