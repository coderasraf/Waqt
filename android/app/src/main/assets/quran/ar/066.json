[{"j":28,"p":560,"r":224,"u":["يَ{madda_obligatory_mottasel|ـٰٓ}أَيُّهَا","{ham_wasl|ٱ}{laam_shamsiyah|ل}{ghunnah|نّ}َبِىُّ","لِمَ","تُحَرِّمُ","م{madda_obligatory_monfasel|َآ}","أَحَلَّ","{ham_wasl|ٱ}للَّهُ","لَكَ‌ۖ","تَ{qalaqah|بۡ}تَغِى","مَرۡضَاتَ","أَزۡو{madda_normal|ٰ}جِكَ‌ۚ","وَ{ham_wasl|ٱ}للَّهُ","غَفُو{idgham_wo_ghunnah|رٌ}","{idgham_wo_ghunnah|ر}َّح{madda_permissible|ِي}مٌ"],"i":["يٰۤاَيُّهَا","النَّبِىُّ","لِمَ","تُحَرِّمُ","مَاۤ","اَحَلَّ","اللّٰهُ","لَـكَ​ۚ","تَبۡتَغِىۡ","مَرۡضَاتَ","اَزۡوَاجِكَ​ؕ","وَاللّٰهُ","غَفُوۡرٌ","رَّحِيۡمٌ‏"]},{"j":28,"p":560,"r":224,"u":["قَ{qalaqah|دۡ}","فَرَضَ","{ham_wasl|ٱ}للَّهُ","لَكُمۡ","تَحِلَّةَ","أَيۡمَ{madda_normal|ـٰ}نِكُمۡ‌ۚ","وَ{ham_wasl|ٱ}للَّهُ","مَوۡلَ{madda_normal|ـٰ}كُمۡ‌ۖ","وَهُوَ","{ham_wasl|ٱ}لۡعَلِيمُ","{ham_wasl|ٱ}لۡحَك{madda_permissible|ِي}مُ"],"i":["قَدۡ","فَرَضَ","اللّٰهُ","لَـكُمۡ","تَحِلَّةَ","اَيۡمَانِكُمۡ​ؕ","وَاللّٰهُ","مَوۡلٰٮكُمۡ​ۚ","وَهُوَ","الۡعَلِيۡمُ","الۡحَكِيۡمُ‏"]},{"j":28,"p":560,"r":224,"u":["وَإِذۡ","أَسَرَّ","{ham_wasl|ٱ}{laam_shamsiyah|ل}{ghunnah|نّ}َبِىُّ","إِلَىٰ","بَعۡضِ","أَزۡو{madda_normal|ٰ}جِه{madda_normal|ِۦ}","حَدِي{ikhafa|ثًا}","{ikhafa|ف}َلَ{ghunnah|مّ}َا","نَبَّأَتۡ","بِه{madda_normal|ِۦ}","وَأَظۡهَرَهُ","{ham_wasl|ٱ}للَّهُ","عَلَيۡهِ","عَرَّفَ","بَعۡضَهُ{madda_normal|ۥ}","وَأَعۡرَضَ","ع{iqlab|َنۢ}","{iqlab|ب}َعۡ{ikhafa|ضٍ‌ۖ}","{ikhafa|ف}َلَ{ghunnah|مّ}َا","نَبَّأَهَا","بِه{madda_normal|ِۦ}","قَالَتۡ","مَنۡ","أَ{iqlab|نۢب}َأَكَ","هَ{madda_normal|ـٰ}ذَا‌ۖ","قَالَ","نَبَّأَنِىَ","{ham_wasl|ٱ}لۡعَلِيمُ","{ham_wasl|ٱ}لۡخَب{madda_permissible|ِي}رُ"],"i":["وَاِذۡ","اَسَرَّ","النَّبِىُّ","اِلٰى","بَعۡضِ","اَزۡوَاجِهٖ","حَدِيۡثًا​ۚ","فَلَمَّا","نَـبَّاَتۡ","بِهٖ","وَاَظۡهَرَهُ","اللّٰهُ","عَلَيۡهِ","عَرَّفَ","بَعۡضَهٗ","وَاَعۡرَضَ","عَنۡۢ","بَعۡضٍ​ۚ","فَلَمَّا","نَـبَّاَهَا","بِهٖ","قَالَتۡ","مَنۡ","اَنۡۢبَاَكَ","هٰذَا​ؕ","قَالَ","نَـبَّاَنِىَ","الۡعَلِيۡمُ","الۡخَبِیْرُ‏"]},{"j":28,"p":560,"r":224,"u":["إِ{ikhafa|ن}","{ikhafa|ت}َتُوب{madda_obligatory_monfasel|َآ}","إِلَى","{ha