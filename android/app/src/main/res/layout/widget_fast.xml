<?xml version="1.0" encoding="utf-8"?>
<!-- Sehri and Iftar (4×1): today's times, with a countdown to the next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/f_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/w_fast"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:textColor="#CCFFE2A0"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/f_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="Ramadan · day 5"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
            android:id="@+id/f_s_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sehri ends"
            android:textColor="#B3FFFFFF"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/f_s_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4:43"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
        <Chronometer
            android:id="@+id/f_s_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:countDown="true"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/gold"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
            android:id="@+id/f_i_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Iftar"
            android:textColor="#B3FFFFFF"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/f_i_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5:26"
            android:textColor="@color/gold"
            android:textSize="18sp"
            android:textStyle="bold" />
        <Chronometer
            android:id="@+id/f_i_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:countDown="true"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/gold"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
