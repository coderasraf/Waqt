<?xml version="1.0" encoding="utf-8"?>
<!-- Ayah of the day (4×2): the verse in Arabic, its meaning and where it is. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_gold"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/v_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/w_verse"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:textColor="#CCFFE2A0"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/v_ref"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ash-Sharh 94:6"
            android:textColor="#B3FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/v_ar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center_vertical|end"
        android:lineSpacingMultiplier="1.15"
        android:autoSizeMaxTextSize="21sp"
        android:autoSizeMinTextSize="13sp"
        android:autoSizeTextType="uniform"
        android:maxLines="3"
        android:text="إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا"
        android:textColor="#FFFFF1D6"
        android:textDirection="rtl"
        android:textSize="21sp" />

    <TextView
        android:id="@+id/v_mean"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:lineSpacingExtra="1dp"
        android:maxLines="3"
        android:text="Indeed, with hardship comes ease."
        android:textColor="#E6FFFFFF"
        android:textSize="13sp" />
</LinearLayout>
