<?xml version="1.0" encoding="utf-8"?>
<!-- Name of Allah of the day (2×2). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_green"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/n_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/w_name"
        android:textAllCaps="true"
        android:letterSpacing="0.12"
        android:textColor="#CCF3D891"
        android:textSize="9sp" />
    <TextView
        android:id="@+id/n_ar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="الرَّحْمٰنُ"
        android:textColor="#FFF3D891"
        android:textSize="34sp" />
    <TextView
        android:id="@+id/n_tr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="Ar-Raḥmān"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/n_mean"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:text="The Most Gracious"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp" />
</LinearLayout>
